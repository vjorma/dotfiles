{
  "title": "Shift+Enter only in browsers (Chrome, Safari, Opera)",
  "rules": [
    {
      "description": "Shift+Enter only when frontmost app is Chrome, Safari, or Opera",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "return_or_enter" },
          "to": [
            { "key_code": "return_or_enter", "modifiers": ["shift"] }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.google\\.Chrome$",
                "^com\\.apple\\.Safari$",
                "^com\\.operasoftware\\.Opera$"
              ]
            }
          ]
        }
      ]
    }
  ]
}

